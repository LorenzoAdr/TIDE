# Optional older baseline: Ubuntu 18.04 (glibc ~2.27). Requires GCC 8 for C++17.
FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    software-properties-common \
    wget \
    && rm -rf /var/lib/apt/lists/*

# GCC 8 for std::filesystem and full C++17 support.
# build-essential later pulls g++-7; keep gcc-8/g++-8 as the defaults and set CC/CXX.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-8 \
    g++-8 \
    libstdc++-8-dev \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-8 80 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-8 80 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-8 80 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-8
ENV CXX=g++-8

# CMake 3.20+ via Kitware APT.
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc \
    | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ bionic main' \
    > /etc/apt/sources.list.d/kitware.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    build-essential \
    cmake \
    git \
    ninja-build \
    unzip \
    xz-utils \
    zstd \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-8 80 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-8 80 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-8 80 \
    && rm -rf /var/lib/apt/lists/*

# Node.js + npx: tree-sitter-latex needs parser.c at configure time.
# Official tree-sitter-cli / GitHub binaries need GLIBC ≥ 2.28, so on Bionic
# (2.27) generation must happen on the host via tools/pregenerate-tree-sitter-latex.sh
# (TUIDE_TREE_SITTER_LATEX_GENERATED). Node here is only for tooling that can run
# with the unofficial glibc-2.17 build when needed.
ARG NODE_VERSION=22.16.0
RUN curl -fsSL "https://unofficial-builds.nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64-glibc-217.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version && npx --version

WORKDIR /src

CMD ["./tools/compile.sh", "-y", "--build-backend=host"]
