# Optional older baseline: Ubuntu 18.04 (glibc ~2.27). Requires GCC 8 for C++17.
FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    software-properties-common \
    wget \
    && rm -rf /var/lib/apt/lists/*

# GCC 8 for std::filesystem and full C++17 support.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-8 \
    g++-8 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-8 80 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-8 80 \
    && rm -rf /var/lib/apt/lists/*

# CMake 3.20+ via Kitware APT.
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc \
    | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ bionic main' \
    > /etc/apt/sources.list.d/kitware.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    build-essential \
    cmake \
    git \
    ninja-build \
    unzip \
    zstd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

CMD ["./tools/compile.sh", "-y", \
     "--bundle-clangd", "--force-bundled-clangd", \
     "--bundle-gdb", "--force-bundled-gdb"]
