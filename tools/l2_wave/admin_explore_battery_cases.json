      "gold": {
        "expect_exit": ["confirmar_editar", "seguir_explorando", "confirmar_cerrar"],
        "expect_not_already_implemented": true,
        "false_friend_forbid_in_cubre_or_reply": ["ya está implementad", "ya está en el código", "funcionalidad solicitada ya"]
      }
