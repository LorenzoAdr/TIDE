        "expect_exit": ["confirmar_cerrar", "confirmar_editar"],
        "symbols_any": ["git_branch", "branch"],
        "false_friend_forbid": []
      }
    },
    {
      "id": "03_short_hole_pink_gutter",
      "kind": "no_existe",
      "difficulty": "media",
      "style": "corto_claro",
      "prompt": "dónde se pinta el gutter rosa fluorescente al guardar un archivo",
      "gold": {
        "expect_exit": ["confirmar_cerrar", "ask_user"],
        "expect_not_already_implemented": true,
        "false_friend_forbid": ["DiagnosticError", "underlined"]
      }
    },
    {
