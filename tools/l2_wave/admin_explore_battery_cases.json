{
  "name": "admin_explore_pilot_v1",
  "diet": "explore_only + typed notebook + confirm cerrar/editar",
  "why": "Estadística nocturna: ~20 prompts diversos sobre el piloto bare + hijo grep+read.",
  "cases": [
    {
      "id": "01_short_exists_adminstate",
      "kind": "existe",
      "difficulty": "baja",
      "style": "corto_claro",
      "prompt": "dónde está definida la struct AdminState",
      "gold": {
        "expect_exit": ["confirmar_cerrar", "confirmar_editar", "cerrar"],
        "symbols_any": ["AdminState", "l2_admin.hpp"],
        "forbid_claim_already_done": false,
        "false_friend_forbid": []
      }
    },
    {
      "id": "02_short_exists_git_branch_ui",
      "kind": "existe",
      "difficulty": "baja",
      "style": "corto_claro",
