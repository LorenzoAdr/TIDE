{
  "version": 3,
  "notes": "Cadenas multi-paso (dummy Cursor = scripts). Gold = expect_chain; shell enrich exige paths/facts tipados.",
  "cases": [
    {
      "id": "chain_ls_head_version",
      "tool": "chain",
      "prompt": "Sin abrir el editor: lista el contenido de tests/fixtures/l2_admin/battery, localiza cases.json, mira solo las primeras líneas con head y dime qué valor tiene el campo \"version\". Cierra con ese número.",
      "gold_do": "spawn",
      "gold_tipo": "shell",
      "expect_inbox": true,
      "expect_log_nonempty": true,
      "expect_spawns_min": 2,
      "expect_notebook_min": 2,
      "expect_close": true,
      "chain_ground_reply": true,
      "expect_notebook_path_any": [
        "cases.json"
      ],
      "expect_notebook_fact_any": [
        "list:dir=",
        "peek:path="
      ],
      "expect_chain": [
        {
          "tipo": "shell",
          "arg_any_substr": [
            "ls"
          ]
        },
        {
          "tipo": "shell",
          "arg_any_substr": [
            "head"
          ]
        },
        {
          "do": "cerrar"
        }
      ],
      "reply_must_not_be_empty": true,
      "reply_should_mention_any": [
        "version",
        "2",
        "cases.json"
      ]
    },
    {
      "id": "chain_ls_tail_do",
